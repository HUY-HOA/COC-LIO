// Minimum account profile fields only; legacy activity/device and cloud village writes are denied.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function verifiedAccount() {
      return request.auth != null
        && (
          request.auth.token.email_verified == true
          || request.auth.token.firebase.sign_in_provider == 'google.com'
        );
    }

    function signedIn() {
      return verifiedAccount()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('requiredAccountDataConsentVersion', 0) == 2
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('accountDisabled', false) != true;
    }

    function isOwner() {
      return verifiedAccount()
        && request.auth.uid == 'T0PXzlCfddNZsWZzva2v1NCrWOf2';
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isVerifiedSelf(userId) {
      return verifiedAccount() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow get: if isOwner() || isVerifiedSelf(userId);
      allow list: if isOwner();

      allow create: if isVerifiedSelf(userId)
        && request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'givenName',
          'familyName',
          'photoUrl',
          'emailVerified',
          'providerId',
          'signInCount',
          'lastSignInAt',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.emailVerified == request.auth.token.email_verified
        && request.resource.data.providerId == 'google.com'
        && request.resource.data.signInCount == 1
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 120
        && request.resource.data.givenName is string
        && request.resource.data.givenName.size() <= 80
        && request.resource.data.familyName is string
        && request.resource.data.familyName.size() <= 80
        && request.resource.data.photoUrl is string
        && request.resource.data.photoUrl.size() <= 2048
        && request.resource.data.lastSignInAt == request.time
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isOwner()
        || (
          isVerifiedSelf(userId)
          && resource.data.get('accountDisabled', false) != true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'email',
            'displayName',
            'givenName',
            'familyName',
            'photoUrl',
            'emailVerified',
            'providerId',
            'preferredName',
            'requiredAccountDataConsentVersion',
            'requiredAccountDataConsentAt',
            'signInCount',
            'lastSignInAt',
            'updatedAt'
          ])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.emailVerified == request.auth.token.email_verified
          && request.resource.data.providerId == 'google.com'
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 120
          && request.resource.data.givenName is string
          && request.resource.data.givenName.size() <= 80
          && request.resource.data.familyName is string
          && request.resource.data.familyName.size() <= 80
          && request.resource.data.photoUrl is string
          && request.resource.data.photoUrl.size() <= 2048
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['preferredName'])
            || (
              request.resource.data.preferredName is string
              && request.resource.data.preferredName.size() > 0
              && request.resource.data.preferredName.size() <= 40
            )
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['requiredAccountDataConsentVersion', 'requiredAccountDataConsentAt'])
            || (
              request.resource.data.diff(resource.data).affectedKeys().hasAll([
                'requiredAccountDataConsentVersion',
                'requiredAccountDataConsentAt'
              ])
              && request.resource.data.requiredAccountDataConsentVersion == 2
              && request.resource.data.requiredAccountDataConsentAt == request.time
            )
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['signInCount', 'lastSignInAt'])
            || (
              request.resource.data.diff(resource.data).affectedKeys().hasAll(['signInCount', 'lastSignInAt'])
              && request.resource.data.signInCount == resource.data.get('signInCount', 0) + 1
              && request.resource.data.lastSignInAt == request.time
            )
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['updatedAt'])
            || request.resource.data.updatedAt == request.time
          )
        );

      allow delete: if isOwner() || isVerifiedSelf(userId);
    }

    match /users/{userId}/village_snapshots/{snapshotId} {
      // Historical snapshots remain readable by their owner and the account owner,
      // but the current app stores village JSON locally and must not upload new copies.
      allow get, list: if isOwner() || isSelf(userId);
      allow create, update: if false;
      allow delete: if isOwner() || isSelf(userId);
    }

    // Legacy community chat, shared JSON and attachment archives are no longer accessible.
    // Unmatched collections remain denied by the catch-all rule.

    match /app_updates/{updateId} {
      allow get, list: if signedIn();

      allow create: if false;

      allow update: if isOwner();
      allow delete: if isOwner();
    }

    match /licenses/{userId} {
      allow get: if isOwner() || isSelf(userId);
      allow list, create, update, delete: if isOwner();
    }

    match /admin/{document=**} {
      allow read, write: if isOwner();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
