rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    function isOwner() {
      return signedIn()
        && request.auth.token.email == 'phunghuyhoahaikba@gmail.com';
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow get: if isOwner() || isSelf(userId);
      allow list: if isOwner();

      allow create: if isSelf(userId)
        && request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'givenName',
          'familyName',
          'photoUrl',
          'emailVerified',
          'providerId',
          'signInCount',
          'lastSignInAt',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.emailVerified == request.auth.token.email_verified
        && request.resource.data.providerId == 'google.com'
        && request.resource.data.signInCount == 1;

      allow update: if isOwner()
        || (
          isSelf(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'email',
            'displayName',
            'givenName',
            'familyName',
            'photoUrl',
            'emailVerified',
            'providerId',
            'preferredName',
            'dataSharingConsent',
            'signInCount',
            'lastSignInAt',
            'updatedAt'
          ])
          && (
            !request.resource.data.keys().hasAny(['preferredName'])
            || (
              request.resource.data.preferredName is string
              && request.resource.data.preferredName.size() > 0
              && request.resource.data.preferredName.size() <= 40
            )
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['dataSharingConsent'])
            || request.resource.data.dataSharingConsent is bool
          )
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.emailVerified == request.auth.token.email_verified
          && request.resource.data.providerId == 'google.com'
          && request.resource.data.createdAt == resource.data.createdAt
        );

      allow delete: if isOwner();
    }

    match /community_messages/{messageId} {
      allow get, list: if signedIn();

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'uid',
          'displayName',
          'photoUrl',
          'type',
          'text',
          'fileName',
          'storagePath',
          'downloadUrl',
          'contentType',
          'fileSize',
          'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.photoUrl is string
        && request.resource.data.photoUrl.size() <= 1000
        && request.resource.data.type in ['text', 'image', 'file']
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 2000
        && request.resource.data.fileName is string
        && request.resource.data.storagePath is string
        && request.resource.data.downloadUrl is string
        && request.resource.data.contentType is string
        && request.resource.data.fileSize is int
        && request.resource.data.createdAt == request.time
        && (
          (
            request.resource.data.type == 'text'
            && request.resource.data.text.size() > 0
            && request.resource.data.storagePath == ''
            && request.resource.data.downloadUrl == ''
            && request.resource.data.contentType == ''
            && request.resource.data.fileSize == 0
          )
          ||
          (
            request.resource.data.type == 'image'
            && isOwner()
            && request.resource.data.contentType.matches('image/.*')
            && request.resource.data.storagePath.matches('community/' + request.auth.uid + '/.*')
            && request.resource.data.downloadUrl.matches('https://.*')
            && request.resource.data.fileName.size() > 0
            && request.resource.data.fileSize > 0
            && request.resource.data.fileSize <= 15 * 1024 * 1024
          )
          ||
          (
            request.resource.data.type == 'file'
            && isOwner()
            && request.resource.data.contentType in [
              'application/pdf',
              'text/plain',
              'application/zip',
              'application/msword',
              'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
              'application/vnd.ms-powerpoint',
              'application/vnd.openxmlformats-officedocument.presentationml.presentation',
              'application/vnd.ms-excel',
              'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
              'application/vnd.android.package-archive'
            ]
            && (
              request.resource.data.contentType != 'application/vnd.android.package-archive'
              || isOwner()
            )
            && request.resource.data.storagePath.matches('community/' + request.auth.uid + '/.*')
            && request.resource.data.downloadUrl.matches('https://.*')
            && request.resource.data.fileName.size() > 0
            && request.resource.data.fileSize > 0
            && request.resource.data.fileSize <= 15 * 1024 * 1024
          )
        );

      allow delete: if isOwner()
        && (
          (
            resource.data.type == 'text'
            && existsAfter(/databases/$(database)/documents/community_deleted_messages/$(messageId))
          )
          || (
            resource.data.type == 'image'
            && existsAfter(/databases/$(database)/documents/community_deleted_images/$(messageId))
          )
          || (
            resource.data.type == 'file'
            && existsAfter(/databases/$(database)/documents/community_deleted_files/$(messageId))
          )
        );
    }

    match /community_deleted_messages/{archiveId} {
      allow get, list, create, update, delete: if isOwner();
    }

    match /community_deleted_images/{archiveId} {
      allow get, list, create, update, delete: if isOwner();
    }

    match /community_deleted_files/{archiveId} {
      allow get, list, create, update, delete: if isOwner();
    }

    match /app_update_archive/{archiveId} {
      allow get, list, create, update, delete: if isOwner();
    }

    match /app_updates/{updateId} {
      allow get, list: if signedIn();

      allow create: if isOwner()
        && request.resource.data.keys().hasOnly([
          'versionName',
          'notes',
          'fileName',
          'storagePath',
          'downloadUrl',
          'fileSize',
          'createdBy',
          'createdAt'
        ])
        && request.resource.data.versionName is string
        && request.resource.data.versionName.size() > 0
        && request.resource.data.versionName.size() <= 40
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 3000
        && request.resource.data.fileName is string
        && request.resource.data.fileName.matches('.*\\.apk')
        && request.resource.data.storagePath is string
        && request.resource.data.storagePath.matches('updates/.*')
        && request.resource.data.downloadUrl is string
        && request.resource.data.downloadUrl.matches('https://.*')
        && request.resource.data.fileSize is int
        && request.resource.data.fileSize > 0
        && request.resource.data.fileSize <= 150 * 1024 * 1024
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;

      allow update: if isOwner();
      allow delete: if isOwner()
        && existsAfter(/databases/$(database)/documents/app_update_archive/$(updateId));
    }

    match /licenses/{userId} {
      allow get: if isOwner() || isSelf(userId);
      allow list, create, update, delete: if isOwner();
    }

    match /admin/{document=**} {
      allow read, write: if isOwner();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
