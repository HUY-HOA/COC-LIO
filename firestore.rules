rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function verifiedAccount() {
      return request.auth != null
        && (
          request.auth.token.email_verified == true
          || request.auth.token.firebase.sign_in_provider == 'google.com'
        );
    }

    function signedIn() {
      return verifiedAccount()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('accountDisabled', false) != true;
    }

    function isOwner() {
      return verifiedAccount()
        && request.auth.uid == 'T0PXzlCfddNZsWZzva2v1NCrWOf2';
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isVerifiedSelf(userId) {
      return verifiedAccount() && request.auth.uid == userId;
    }

    function allowedProfileUpdateFields() {
      return [
        'email', 'displayName', 'emailVerified', 'providerId',
        'preferredName', 'signInCount', 'lastSignInAt', 'updatedAt',
        'givenName', 'familyName', 'photoUrl',
        'deviceManufacturer', 'deviceModel', 'deviceBrand', 'deviceProduct',
        'deviceCodeName', 'supportedAbis', 'localeTag', 'timeZoneId',
        'screenWidthPx', 'screenHeightPx', 'densityDpi', 'networkType',
        'networkStatus', 'networkValidated', 'androidVersion', 'sdkInt',
        'appVersionName', 'appVersionCode', 'lastIp', 'lastIpCapturedAt',
        'firstOpenedAt', 'lastOpenedAt', 'appOpenCount', 'lastActiveAt',
        'lastBackgroundAt', 'sessionStartedAt', 'activityUpdatedAt',
        'lastActivityEvent', 'lastSessionDurationSeconds', 'totalForegroundSeconds',
        'requiredAccountDataConsentVersion', 'requiredAccountDataConsentAt',
        'activityDataConsentVersion', 'dataSharingConsent', 'analyticsConsent',
        'diagnosticsConsent', 'villageDataConsent', 'activityConsentAt',
        'lastVillageTag', 'lastVillageName', 'lastVillageTimestamp',
        'lastVillageTownHallLevel', 'lastVillageBuilderHallLevel',
        'villageImportCount', 'lastVillageSyncedAt', 'lastVillageRawJsonBytes'
      ];
    }

    function obsoleteProfileFields() {
      return [
        'givenName', 'familyName', 'photoUrl',
        'deviceManufacturer', 'deviceModel', 'deviceBrand', 'deviceProduct',
        'deviceCodeName', 'supportedAbis', 'localeTag', 'timeZoneId',
        'screenWidthPx', 'screenHeightPx', 'densityDpi', 'networkType',
        'networkStatus', 'networkValidated', 'androidVersion', 'sdkInt',
        'appVersionName', 'appVersionCode', 'lastIp', 'lastIpCapturedAt',
        'firstOpenedAt', 'lastOpenedAt', 'appOpenCount', 'lastActiveAt',
        'lastBackgroundAt', 'sessionStartedAt', 'activityUpdatedAt',
        'lastActivityEvent', 'lastSessionDurationSeconds', 'totalForegroundSeconds',
        'requiredAccountDataConsentVersion', 'requiredAccountDataConsentAt',
        'activityDataConsentVersion', 'dataSharingConsent', 'analyticsConsent',
        'diagnosticsConsent', 'villageDataConsent', 'activityConsentAt',
        'lastVillageTag', 'lastVillageName', 'lastVillageTimestamp',
        'lastVillageTownHallLevel', 'lastVillageBuilderHallLevel',
        'villageImportCount', 'lastVillageSyncedAt', 'lastVillageRawJsonBytes'
      ];
    }

    match /users/{userId} {
      allow get: if isOwner() || isVerifiedSelf(userId);
      allow list: if isOwner();

      allow create: if isVerifiedSelf(userId)
        && request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'emailVerified',
          'providerId',
          'signInCount',
          'lastSignInAt',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.emailVerified == request.auth.token.email_verified
        && request.resource.data.providerId == 'google.com'
        && request.resource.data.signInCount == 1
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 120
        && request.resource.data.lastSignInAt == request.time
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isOwner()
        || (
          isVerifiedSelf(userId)
          && resource.data.get('accountDisabled', false) != true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedProfileUpdateFields())
          && request.resource.data.diff(resource.data).removedKeys().hasOnly(obsoleteProfileFields())
          && !request.resource.data.keys().hasAny(obsoleteProfileFields())
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.emailVerified == request.auth.token.email_verified
          && request.resource.data.providerId == 'google.com'
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 120
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['preferredName'])
            || (
              request.resource.data.preferredName is string
              && request.resource.data.preferredName.size() > 0
              && request.resource.data.preferredName.size() <= 40
            )
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['signInCount', 'lastSignInAt'])
            || (
              request.resource.data.diff(resource.data).affectedKeys().hasAll(['signInCount', 'lastSignInAt'])
              && request.resource.data.signInCount == resource.data.get('signInCount', 0) + 1
              && request.resource.data.lastSignInAt == request.time
            )
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['updatedAt'])
            || request.resource.data.updatedAt == request.time
          )
        );

      allow delete: if isOwner() || isVerifiedSelf(userId);
    }

    match /users/{userId}/village_snapshots/{snapshotId} {
      // Historical snapshots from older releases may still exist. Current releases
      // keep village JSON locally and do not create or update cloud snapshots.
      allow get, list: if isOwner() || isSelf(userId);
      allow create, update: if false;
      allow delete: if isOwner() || isSelf(userId);
    }

    match /app_updates/{updateId} {
      allow get, list: if signedIn();
      allow create: if false;
      allow update, delete: if isOwner();
    }

    match /licenses/{userId} {
      allow get: if isOwner() || isSelf(userId);
      allow list, create, update, delete: if isOwner();
    }

    match /admin/{document=**} {
      allow read, write: if isOwner();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
