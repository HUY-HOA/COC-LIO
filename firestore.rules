rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    function isOwner() {
      return signedIn()
        && request.auth.token.email == 'phunghuyhoahaikba@gmail.com';
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow get: if isOwner() || isSelf(userId);
      allow list: if isOwner();

      allow create: if isSelf(userId)
        && request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'givenName',
          'familyName',
          'photoUrl',
          'emailVerified',
          'providerId',
          'signInCount',
          'lastSignInAt',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.emailVerified == request.auth.token.email_verified
        && request.resource.data.providerId == 'google.com'
        && request.resource.data.signInCount == 1;

      allow update: if isOwner()
        || (
          isSelf(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'displayName',
            'givenName',
            'familyName',
            'photoUrl',
            'emailVerified',
            'providerId',
            'signInCount',
            'lastSignInAt',
            'updatedAt'
          ])
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email
          && request.resource.data.emailVerified == request.auth.token.email_verified
          && request.resource.data.providerId == 'google.com'
          && request.resource.data.createdAt == resource.data.createdAt
        );

      allow delete: if isOwner();
    }

    match /licenses/{userId} {
      allow get: if isOwner() || isSelf(userId);
      allow list, create, update, delete: if isOwner();
    }

    match /admin/{document=**} {
      allow read, write: if isOwner();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
