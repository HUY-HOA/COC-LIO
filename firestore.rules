// Account profiles allow bounded technical compatibility/network fields; detailed activity and cloud village writes remain denied.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function verifiedAccount() {
      return request.auth != null
        && (
          request.auth.token.email_verified == true
          || request.auth.token.firebase.sign_in_provider == 'google.com'
        );
    }

    function signedIn() {
      return verifiedAccount()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('requiredAccountDataConsentVersion', 0) == 2
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('accountDisabled', false) != true;
    }

    function isOwner() {
      return verifiedAccount()
        && request.auth.uid == 'T0PXzlCfddNZsWZzva2v1NCrWOf2';
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isVerifiedSelf(userId) {
      return verifiedAccount() && request.auth.uid == userId;
    }

    function validTechnicalProfile(data) {
      return data.deviceManufacturer is string && data.deviceManufacturer.size() <= 80
        && data.deviceModel is string && data.deviceModel.size() <= 100
        && data.deviceBrand is string && data.deviceBrand.size() <= 80
        && data.deviceProduct is string && data.deviceProduct.size() <= 100
        && data.deviceCodeName is string && data.deviceCodeName.size() <= 100
        && data.supportedAbis is string && data.supportedAbis.size() <= 300
        && data.localeTag is string && data.localeTag.size() <= 40
        && data.timeZoneId is string && data.timeZoneId.size() <= 80
        && data.screenWidthPx is int && data.screenWidthPx >= 0 && data.screenWidthPx <= 20000
        && data.screenHeightPx is int && data.screenHeightPx >= 0 && data.screenHeightPx <= 20000
        && data.densityDpi is int && data.densityDpi >= 0 && data.densityDpi <= 2000
        && data.networkType in ['NONE', 'VPN', 'WIFI', 'CELLULAR', 'ETHERNET', 'OTHER']
        && data.networkStatus in ['CONNECTED', 'OFFLINE']
        && data.networkValidated is bool
        && data.androidVersion is string && data.androidVersion.size() <= 40
        && data.sdkInt is int && data.sdkInt >= 0 && data.sdkInt <= 1000
        && data.appVersionName is string && data.appVersionName.size() <= 40
        && data.appVersionCode is int && data.appVersionCode >= 0 && data.appVersionCode <= 2147483647;
    }

    match /users/{userId} {
      allow get: if isOwner() || isVerifiedSelf(userId);
      allow list: if isOwner();

      allow create: if isVerifiedSelf(userId)
        && request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'givenName',
          'familyName',
          'photoUrl',
          'emailVerified',
          'providerId',
          'signInCount',
          'lastSignInAt',
          'createdAt',
          'updatedAt',
          'firstOpenedAt',
          'lastOpenedAt',
          'appOpenCount',
          'deviceManufacturer',
          'deviceModel',
          'deviceBrand',
          'deviceProduct',
          'deviceCodeName',
          'supportedAbis',
          'localeTag',
          'timeZoneId',
          'screenWidthPx',
          'screenHeightPx',
          'densityDpi',
          'networkType',
          'networkStatus',
          'networkValidated',
          'androidVersion',
          'sdkInt',
          'appVersionName',
          'appVersionCode'
        ])
        && validTechnicalProfile(request.resource.data)
        && request.resource.data.firstOpenedAt == request.time
        && request.resource.data.lastOpenedAt == request.time
        && request.resource.data.appOpenCount == 1
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.emailVerified == request.auth.token.email_verified
        && request.resource.data.providerId == 'google.com'
        && request.resource.data.signInCount == 1
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 120
        && request.resource.data.givenName is string
        && request.resource.data.givenName.size() <= 80
        && request.resource.data.familyName is string
        && request.resource.data.familyName.size() <= 80
        && request.resource.data.photoUrl is string
        && request.resource.data.photoUrl.size() <= 2048
        && request.resource.data.lastSignInAt == request.time
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isOwner()
        || (
          isVerifiedSelf(userId)
          && resource.data.get('accountDisabled', false) != true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'email',
            'displayName',
            'givenName',
            'familyName',
            'photoUrl',
            'emailVerified',
            'providerId',
            'preferredName',
            'requiredAccountDataConsentVersion',
            'requiredAccountDataConsentAt',
            'signInCount',
            'lastSignInAt',
            'updatedAt',
            'firstOpenedAt',
            'lastOpenedAt',
            'appOpenCount',
            'deviceManufacturer',
            'deviceModel',
            'deviceBrand',
            'deviceProduct',
            'deviceCodeName',
            'supportedAbis',
            'localeTag',
            'timeZoneId',
            'screenWidthPx',
            'screenHeightPx',
            'densityDpi',
            'networkType',
            'networkStatus',
            'networkValidated',
            'androidVersion',
            'sdkInt',
            'appVersionName',
            'appVersionCode'
          ])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.emailVerified == request.auth.token.email_verified
          && request.resource.data.providerId == 'google.com'
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 120
          && request.resource.data.givenName is string
          && request.resource.data.givenName.size() <= 80
          && request.resource.data.familyName is string
          && request.resource.data.familyName.size() <= 80
          && request.resource.data.photoUrl is string
          && request.resource.data.photoUrl.size() <= 2048
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['preferredName'])
            || (
              request.resource.data.preferredName is string
              && request.resource.data.preferredName.size() > 0
              && request.resource.data.preferredName.size() <= 40
            )
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['requiredAccountDataConsentVersion', 'requiredAccountDataConsentAt'])
            || (
              request.resource.data.diff(resource.data).affectedKeys().hasAll([
                'requiredAccountDataConsentVersion',
                'requiredAccountDataConsentAt'
              ])
              && request.resource.data.requiredAccountDataConsentVersion == 2
              && request.resource.data.requiredAccountDataConsentAt == request.time
            )
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['signInCount', 'lastSignInAt'])
            || (
              request.resource.data.diff(resource.data).affectedKeys().hasAll(['signInCount', 'lastSignInAt'])
              && request.resource.data.signInCount == resource.data.get('signInCount', 0) + 1
              && request.resource.data.lastSignInAt == request.time
            )
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'deviceManufacturer', 'deviceModel', 'deviceBrand', 'deviceProduct',
              'deviceCodeName', 'supportedAbis', 'localeTag', 'timeZoneId',
              'screenWidthPx', 'screenHeightPx', 'densityDpi', 'networkType',
              'networkStatus', 'networkValidated', 'androidVersion', 'sdkInt',
              'appVersionName', 'appVersionCode'
            ])
            || validTechnicalProfile(request.resource.data)
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['firstOpenedAt'])
            || request.resource.data.firstOpenedAt == resource.data.get('firstOpenedAt', null)
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['appOpenCount', 'lastOpenedAt'])
            || (
              request.resource.data.diff(resource.data).affectedKeys().hasAll(['appOpenCount', 'lastOpenedAt'])
              && request.resource.data.appOpenCount == resource.data.get('appOpenCount', 0) + 1
              && request.resource.data.lastOpenedAt == request.time
            )
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['updatedAt'])
            || request.resource.data.updatedAt == request.time
          )
        );

      allow delete: if isOwner() || isVerifiedSelf(userId);
    }

    match /users/{userId}/village_snapshots/{snapshotId} {
      // Historical snapshots remain readable by their owner and the account owner,
      // but the current app stores village JSON locally and must not upload new copies.
      allow get, list: if isOwner() || isSelf(userId);
      allow create, update: if false;
      allow delete: if isOwner() || isSelf(userId);
    }

    // Legacy community chat, shared JSON and attachment archives are no longer accessible.
    // Unmatched collections remain denied by the catch-all rule.

    match /app_updates/{updateId} {
      allow get, list: if signedIn();

      allow create: if false;

      allow update: if isOwner();
      allow delete: if isOwner();
    }

    match /licenses/{userId} {
      allow get: if isOwner() || isSelf(userId);
      allow list, create, update, delete: if isOwner();
    }

    match /admin/{document=**} {
      allow read, write: if isOwner();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
