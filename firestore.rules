rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function verifiedAccount() {
      return request.auth != null
        && (
          request.auth.token.email_verified == true
          || request.auth.token.firebase.sign_in_provider == 'google.com'
        );
    }

    function signedIn() {
      return verifiedAccount()
        && (
          !exists(/databases/$(database)/documents/users/$(request.auth.uid))
          || !get(/databases/$(database)/documents/users/$(request.auth.uid)).data.keys().hasAny(['accountDisabled'])
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountDisabled != true
        );
    }

    function isOwner() {
      return verifiedAccount()
        && request.auth.token.email == 'phunghuyhoahaikba@gmail.com';
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isVerifiedSelf(userId) {
      return verifiedAccount() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow get: if isOwner() || isVerifiedSelf(userId);
      allow list: if isOwner();

      allow create: if isSelf(userId)
        && request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'givenName',
          'familyName',
          'photoUrl',
          'emailVerified',
          'providerId',
          'dataSharingConsent',
          'analyticsConsent',
          'diagnosticsConsent',
          'villageDataConsent',
          'activityDataConsentVersion',
          'activityConsentAt',
          'signInCount',
          'lastSignInAt',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.emailVerified == request.auth.token.email_verified
        && request.resource.data.providerId == 'google.com'
        && request.resource.data.signInCount == 1
        && (
          !request.resource.data.keys().hasAny(['dataSharingConsent'])
          || request.resource.data.dataSharingConsent is bool
        )
        && (
          !request.resource.data.keys().hasAny(['analyticsConsent'])
          || request.resource.data.analyticsConsent is bool
        )
        && (
          !request.resource.data.keys().hasAny(['diagnosticsConsent'])
          || request.resource.data.diagnosticsConsent is bool
        )
        && (
          !request.resource.data.keys().hasAny(['villageDataConsent'])
          || request.resource.data.villageDataConsent is bool
        )
        && (
          !request.resource.data.keys().hasAny(['activityDataConsentVersion'])
          || request.resource.data.activityDataConsentVersion is int
        );

      allow update: if isOwner()
        || (
          isSelf(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'email',
            'displayName',
            'givenName',
            'familyName',
            'photoUrl',
            'emailVerified',
            'providerId',
            'preferredName',
            'dataSharingConsent',
            'analyticsConsent',
            'diagnosticsConsent',
            'villageDataConsent',
            'activityDataConsentVersion',
            'activityConsentAt',
            'requiredAccountDataConsentVersion',
            'requiredAccountDataConsentAt',
            'signInCount',
            'lastSignInAt',
            'updatedAt',
            'lastActivityEvent',
            'activityUpdatedAt',
            'firstOpenedAt',
            'lastOpenedAt',
            'lastActiveAt',
            'lastBackgroundAt',
            'sessionStartedAt',
            'appOpenCount',
            'lastSessionDurationSeconds',
            'totalForegroundSeconds',
            'deviceManufacturer',
            'deviceModel',
            'deviceBrand',
            'deviceProduct',
            'deviceCodeName',
            'supportedAbis',
            'localeTag',
            'timeZoneId',
            'screenWidthPx',
            'screenHeightPx',
            'densityDpi',
            'networkType',
            'androidVersion',
            'sdkInt',
            'appVersionName',
            'appVersionCode',
            'lastVillageTag',
            'lastVillageName',
            'lastVillageTimestamp',
            'lastVillageTownHallLevel',
            'lastVillageBuilderHallLevel',
            'villageImportCount',
            'lastVillageSyncedAt',
            'lastVillageRawJsonBytes'
          ])
          && (
            !request.resource.data.keys().hasAny(['preferredName'])
            || (
              request.resource.data.preferredName is string
              && request.resource.data.preferredName.size() > 0
              && request.resource.data.preferredName.size() <= 40
            )
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['dataSharingConsent'])
            || request.resource.data.dataSharingConsent is bool
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['analyticsConsent'])
            || request.resource.data.analyticsConsent is bool
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['diagnosticsConsent'])
            || request.resource.data.diagnosticsConsent is bool
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['villageDataConsent'])
            || request.resource.data.villageDataConsent is bool
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['activityConsentAt'])
            || request.resource.data.activityConsentAt is timestamp
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['requiredAccountDataConsentVersion'])
            || (
              request.resource.data.requiredAccountDataConsentVersion is int
              && request.resource.data.requiredAccountDataConsentVersion == 1
            )
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['requiredAccountDataConsentAt'])
            || request.resource.data.requiredAccountDataConsentAt is timestamp
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'requiredAccountDataConsentVersion',
              'requiredAccountDataConsentAt'
            ])
            || (
              request.resource.data.requiredAccountDataConsentVersion == 1
              && request.resource.data.requiredAccountDataConsentAt is timestamp
            )
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'dataSharingConsent',
              'analyticsConsent',
              'diagnosticsConsent',
              'villageDataConsent',
              'activityDataConsentVersion',
              'activityConsentAt'
            ])
            || (
              request.resource.data.activityDataConsentVersion == 6
              && request.resource.data.activityConsentAt is timestamp
            )
          )
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.emailVerified == request.auth.token.email_verified
          && request.resource.data.providerId == 'google.com'
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'lastActivityEvent',
              'activityUpdatedAt',
              'firstOpenedAt',
              'lastOpenedAt',
              'lastActiveAt',
              'lastBackgroundAt',
              'sessionStartedAt',
              'appOpenCount',
              'lastSessionDurationSeconds',
              'totalForegroundSeconds',
              'deviceManufacturer',
              'deviceModel',
              'deviceBrand',
              'deviceProduct',
              'deviceCodeName',
              'supportedAbis',
              'localeTag',
              'timeZoneId',
              'screenWidthPx',
              'screenHeightPx',
              'densityDpi',
              'networkType',
              'androidVersion',
              'sdkInt',
              'appVersionName',
              'appVersionCode'
            ])
            || (
              resource.data.dataSharingConsent == true
              && resource.data.activityDataConsentVersion == 6
              && request.resource.data.activityDataConsentVersion == 6
              && request.resource.data.lastActivityEvent in ['open', 'heartbeat', 'background']
              && request.resource.data.activityUpdatedAt == request.time
              && request.resource.data.deviceManufacturer is string
              && request.resource.data.deviceManufacturer.size() <= 60
              && request.resource.data.deviceModel is string
              && request.resource.data.deviceModel.size() <= 100
              && request.resource.data.deviceBrand is string
              && request.resource.data.deviceBrand.size() <= 60
              && request.resource.data.deviceProduct is string
              && request.resource.data.deviceProduct.size() <= 80
              && request.resource.data.deviceCodeName is string
              && request.resource.data.deviceCodeName.size() <= 80
              && request.resource.data.supportedAbis is string
              && request.resource.data.supportedAbis.size() <= 100
              && request.resource.data.localeTag is string
              && request.resource.data.localeTag.size() <= 35
              && request.resource.data.timeZoneId is string
              && request.resource.data.timeZoneId.size() <= 80
              && request.resource.data.screenWidthPx is int
              && request.resource.data.screenWidthPx >= 0
              && request.resource.data.screenHeightPx is int
              && request.resource.data.screenHeightPx >= 0
              && request.resource.data.densityDpi is int
              && request.resource.data.densityDpi >= 0
              && request.resource.data.networkType in ['offline', 'wifi', 'cellular', 'ethernet', 'bluetooth', 'other']
              && request.resource.data.androidVersion is string
              && request.resource.data.androidVersion.size() <= 40
              && request.resource.data.sdkInt is int
              && request.resource.data.sdkInt >= 0
              && request.resource.data.appVersionName is string
              && request.resource.data.appVersionName.size() <= 40
              && request.resource.data.appVersionCode is int
              && request.resource.data.appVersionCode >= 0
              && (
                !request.resource.data.keys().hasAny(['appOpenCount'])
                || request.resource.data.appOpenCount is int
              )
              && (
                !request.resource.data.keys().hasAny(['totalForegroundSeconds'])
                || request.resource.data.totalForegroundSeconds is int
              )
              && (
                !request.resource.data.keys().hasAny(['lastSessionDurationSeconds'])
                || request.resource.data.lastSessionDurationSeconds is int
              )
              && (
                !request.resource.data.keys().hasAny(['firstOpenedAt'])
                || request.resource.data.firstOpenedAt is timestamp
              )
              && (
                !request.resource.data.keys().hasAny(['lastOpenedAt'])
                || request.resource.data.lastOpenedAt is timestamp
              )
              && (
                !request.resource.data.keys().hasAny(['lastActiveAt'])
                || request.resource.data.lastActiveAt is timestamp
              )
              && (
                !request.resource.data.keys().hasAny(['lastBackgroundAt'])
                || request.resource.data.lastBackgroundAt is timestamp
              )
              && (
                !request.resource.data.keys().hasAny(['sessionStartedAt'])
                || request.resource.data.sessionStartedAt is timestamp
              )
            )
          )
          && request.resource.data.createdAt == resource.data.createdAt
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'lastVillageTag',
              'lastVillageName',
              'lastVillageTimestamp',
              'lastVillageTownHallLevel',
              'lastVillageBuilderHallLevel',
              'villageImportCount',
              'lastVillageSyncedAt',
              'lastVillageRawJsonBytes'
            ])
            || (
              resource.data.villageDataConsent == true
              && resource.data.activityDataConsentVersion == 6
              && request.resource.data.lastVillageTag is string
              && request.resource.data.lastVillageTag.matches('^#[A-Za-z0-9]+$')
              && request.resource.data.lastVillageTag.size() <= 20
              && request.resource.data.lastVillageName is string
              && request.resource.data.lastVillageName.size() <= 80
              && request.resource.data.lastVillageTimestamp is int
              && request.resource.data.lastVillageTimestamp >= 0
              && request.resource.data.lastVillageTownHallLevel is int
              && request.resource.data.lastVillageTownHallLevel >= 0
              && request.resource.data.lastVillageTownHallLevel <= 100
              && request.resource.data.lastVillageBuilderHallLevel is int
              && request.resource.data.lastVillageBuilderHallLevel >= 0
              && request.resource.data.lastVillageBuilderHallLevel <= 100
              && request.resource.data.villageImportCount is int
              && request.resource.data.villageImportCount >= 1
              && request.resource.data.lastVillageSyncedAt == request.time
              && request.resource.data.lastVillageRawJsonBytes is int
              && request.resource.data.lastVillageRawJsonBytes > 0
              && request.resource.data.lastVillageRawJsonBytes <= 700000
            )
          )
        );

      allow delete: if isOwner() || isSelf(userId);
    }

    match /users/{userId}/village_snapshots/{snapshotId} {
      allow get, list: if isOwner() || isSelf(userId);

      allow create, update: if isSelf(userId)
        && get(/databases/$(database)/documents/users/$(userId)).data.villageDataConsent == true
        && get(/databases/$(database)/documents/users/$(userId)).data.activityDataConsentVersion == 6
        && request.resource.data.keys().hasOnly([
          'uid', 'playerTag', 'villageName', 'snapshotTimestamp', 'rawJson',
          'rawJsonBytes', 'itemCount', 'extraItemCount', 'activeUpgradeCount',
          'townHallLevel', 'builderHallLevel', 'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.playerTag is string
        && request.resource.data.playerTag.matches('^#[A-Za-z0-9]+$')
        && request.resource.data.playerTag.size() <= 20
        && request.resource.data.villageName is string
        && request.resource.data.villageName.size() <= 80
        && request.resource.data.snapshotTimestamp is int
        && request.resource.data.snapshotTimestamp >= 0
        && request.resource.data.rawJson is string
        && request.resource.data.rawJson.size() > 0
        && request.resource.data.rawJson.size() <= 700000
        && request.resource.data.rawJsonBytes is int
        && request.resource.data.rawJsonBytes > 0
        && request.resource.data.rawJsonBytes <= 700000
        && request.resource.data.itemCount is int
        && request.resource.data.itemCount >= 0
        && request.resource.data.extraItemCount is int
        && request.resource.data.extraItemCount >= 0
        && request.resource.data.activeUpgradeCount is int
        && request.resource.data.activeUpgradeCount >= 0
        && (!request.resource.data.keys().hasAny(['townHallLevel']) || (request.resource.data.townHallLevel is int && request.resource.data.townHallLevel >= 0 && request.resource.data.townHallLevel <= 100))
        && (!request.resource.data.keys().hasAny(['builderHallLevel']) || (request.resource.data.builderHallLevel is int && request.resource.data.builderHallLevel >= 0 && request.resource.data.builderHallLevel <= 100))
        && request.resource.data.createdAt == request.time;

      allow delete: if isOwner() || isSelf(userId);
    }

    match /community_shared_jsons/{jsonId} {
      allow get, list: if signedIn();

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'uid',
          'displayName',
          'playerTag',
          'villageName',
          'timestamp',
          'rawJson',
          'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.playerTag is string
        && request.resource.data.playerTag.matches('^#[A-Za-z0-9]+$')
        && request.resource.data.villageName is string
        && request.resource.data.villageName.size() <= 100
        && request.resource.data.timestamp is int
        && request.resource.data.timestamp > 0
        && request.resource.data.rawJson is string
        && request.resource.data.rawJson.size() > 0
        && request.resource.data.rawJson.size() <= 700000
        && request.resource.data.createdAt == request.time;

      allow update: if false;
      allow delete: if isOwner();
    }

    match /community_messages/{messageId} {
      allow get, list: if signedIn();

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'uid',
          'displayName',
          'senderIsAdmin',
          'photoUrl',
          'type',
          'text',
          'fileName',
          'storagePath',
          'downloadUrl',
          'contentType',
          'fileSize',
          'contentData',
          'sharedJsonId',
          'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 80
        && (
          !request.resource.data.keys().hasAny(['senderIsAdmin'])
          || (
            request.resource.data.senderIsAdmin is bool
            && request.resource.data.senderIsAdmin == isOwner()
          )
        )
        && request.resource.data.photoUrl is string
        && request.resource.data.photoUrl.size() <= 1000
        && request.resource.data.type in ['text', 'json', 'image', 'file']
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 2000
        && request.resource.data.fileName is string
        && request.resource.data.storagePath is string
        && request.resource.data.downloadUrl is string
        && request.resource.data.contentType is string
        && request.resource.data.fileSize is int
        && request.resource.data.contentData is string
        && request.resource.data.contentData.size() <= 480000
        && (
          !request.resource.data.keys().hasAny(['sharedJsonId'])
          || (
            request.resource.data.sharedJsonId is string
            && request.resource.data.sharedJsonId.size() <= 100
          )
        )
        && request.resource.data.createdAt == request.time
        && (
          (
            request.resource.data.type == 'text'
            && request.resource.data.text.size() > 0
            && request.resource.data.storagePath == ''
            && request.resource.data.downloadUrl == ''
            && request.resource.data.contentType == ''
            && request.resource.data.fileSize == 0
            && request.resource.data.contentData == ''
            && (
              !request.resource.data.keys().hasAny(['sharedJsonId'])
              || request.resource.data.sharedJsonId == ''
            )
          )
          ||
          (
            request.resource.data.type == 'image'
            && request.resource.data.contentType == 'image/jpeg'
            && request.resource.data.storagePath == ''
            && request.resource.data.downloadUrl == ''
            && request.resource.data.contentData.size() > 0
            && request.resource.data.contentData.size() <= 480000
            && request.resource.data.fileName.size() > 0
            && request.resource.data.fileSize > 0
            && request.resource.data.fileSize <= 358400
            && (
              !request.resource.data.keys().hasAny(['sharedJsonId'])
              || request.resource.data.sharedJsonId == ''
            )
          )
          ||
          (
            request.resource.data.type == 'file'
            && isOwner()
            && request.resource.data.contentType in [
              'application/pdf',
              'text/plain',
              'application/zip',
              'application/msword',
              'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
              'application/vnd.ms-powerpoint',
              'application/vnd.openxmlformats-officedocument.presentationml.presentation',
              'application/vnd.ms-excel',
              'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
              'application/vnd.android.package-archive'
            ]
            && (
              request.resource.data.contentType != 'application/vnd.android.package-archive'
              || isOwner()
            )
            && request.resource.data.storagePath == ''
            && request.resource.data.downloadUrl == ''
            && request.resource.data.contentData.size() > 0
            && request.resource.data.contentData.size() <= 480000
            && request.resource.data.fileName.size() > 0
            && request.resource.data.fileSize > 0
            && request.resource.data.fileSize <= 358400
            && (
              !request.resource.data.keys().hasAny(['sharedJsonId'])
              || request.resource.data.sharedJsonId == ''
            )
          )
          ||
          (
            request.resource.data.type == 'json'
            && request.resource.data.text.size() > 0
            && request.resource.data.fileName.size() > 0
            && request.resource.data.storagePath == ''
            && request.resource.data.downloadUrl == ''
            && request.resource.data.contentType == 'application/json'
            && request.resource.data.contentData == ''
            && request.resource.data.fileSize > 0
            && request.resource.data.fileSize <= 700000
            && request.resource.data.keys().hasAny(['sharedJsonId'])
            && request.resource.data.sharedJsonId.size() > 0
            && exists(/databases/$(database)/documents/community_shared_jsons/$(request.resource.data.sharedJsonId))
            && get(/databases/$(database)/documents/community_shared_jsons/$(request.resource.data.sharedJsonId)).data.uid == request.auth.uid
          )
        );

      allow delete: if isOwner();
    }

    match /community_deleted_messages/{archiveId} {
      allow get, list, create, update, delete: if isOwner();
    }

    match /community_deleted_images/{archiveId} {
      allow get, list, create, update, delete: if isOwner();
    }

    match /community_deleted_files/{archiveId} {
      allow get, list, create, update, delete: if isOwner();
    }

    match /app_update_archive/{archiveId} {
      allow get, list, create, update, delete: if isOwner();
    }

    match /app_updates/{updateId} {
      allow get, list: if signedIn();

      allow create: if false;

      allow update: if isOwner();
      allow delete: if isOwner();
    }

    match /licenses/{userId} {
      allow get: if isOwner() || isSelf(userId);
      allow list, create, update, delete: if isOwner();
    }

    match /admin/{document=**} {
      allow read, write: if isOwner();
    }

    match /app_remote_content/{contentId} {
      allow get, list: if signedIn();
      allow create, update, delete: if isOwner();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
