rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    function isOwner() {
      return signedIn()
        && request.auth.token.email == 'phunghuyhoahaikba@gmail.com';
    }

    match /community/{userId}/{fileName} {
      allow read: if signedIn();

      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.size > 0
        && request.resource.size <= 15 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType in [
            'application/pdf',
            'text/plain',
            'application/zip',
            'application/msword',
            'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
            'application/vnd.ms-powerpoint',
            'application/vnd.openxmlformats-officedocument.presentationml.presentation',
            'application/vnd.ms-excel',
            'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
          ]
          || (
            isOwner()
            && request.resource.contentType == 'application/vnd.android.package-archive'
          )
        );

      allow delete: if signedIn()
        && (isOwner() || request.auth.uid == userId);
    }

    match /updates/{fileName} {
      allow read: if signedIn();

      allow create, update: if isOwner()
        && fileName.matches('.*\\.apk')
        && request.resource.size > 0
        && request.resource.size <= 150 * 1024 * 1024
        && request.resource.contentType == 'application/vnd.android.package-archive';

      allow delete: if isOwner();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
