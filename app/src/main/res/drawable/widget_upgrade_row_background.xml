<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="#FF00E5FF"
                android:centerColor="#FFA63DFF"
                android:endColor="#FFFF35B8" />
        </shape>
    </item>
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#E8172945" />
            <corners android:radius="9dp" />
        </shape>
    </item>
</layer-list>