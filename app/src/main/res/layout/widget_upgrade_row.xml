<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="58dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="4dp"
    android:background="@drawable/widget_upgrade_row_background">

    <ImageView
        android:id="@+id/row_icon"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginEnd="5dp"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        android:visibility="gone"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/row_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CẤP 14 → 15 • CÒN 56%"
            android:textColor="#FFFFD166"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginTop="3dp">

            <ProgressBar
                android:id="@+id/row_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/widget_progress_horizontal"
                android:indeterminate="false" />

            <Chronometer
                android:id="@+id/row_timer"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:minWidth="84dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:background="@drawable/widget_timer_badge_background"
                android:text="00:00:00"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:shadowColor="#CC000000"
                android:shadowRadius="2"
                android:format="%s" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>