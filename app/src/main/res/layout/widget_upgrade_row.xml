<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="46dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="3dp"
    android:background="@drawable/widget_upgrade_row_background">

    <ImageView
        android:id="@+id/row_icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="3dp"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        android:visibility="gone"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/row_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Đại bác • cấp 14"
            android:textColor="#FFFFFF"
            android:textSize="9sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/row_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:text="Nhà chính • Công trình"
            android:textColor="#9EAFCE"
            android:textSize="7sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_marginTop="1dp">

            <ProgressBar
                android:id="@+id/row_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:layout_gravity="center_vertical"
                android:max="100"
                android:progress="0"
                android:progressTint="#36F4FF"
                android:progressBackgroundTint="#34435F" />

            <Chronometer
                android:id="@+id/row_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="00:00:00 • 100%"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold"
                android:format="%s" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>