<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="@drawable/widget_upgrade_row_background">

    <TextView
        android:id="@+id/row_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Đại bác • cấp 14"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/row_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Nhà chính • Công trình"
        android:textColor="#9EAFCE"
        android:textSize="10sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <Chronometer
        android:id="@+id/row_timer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Còn 01:23:45"
        android:textColor="#FFD166"
        android:textSize="12sp"
        android:textStyle="bold"
        android:format="Còn %s" />

    <ProgressBar
        android:id="@+id/row_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="5dp"
        android:max="100"
        android:progress="0"
        android:progressTint="#36F4FF"
        android:progressBackgroundTint="#34435F" />

    <TextView
        android:id="@+id/row_percent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Đã qua 45%"
        android:textColor="#9EAFCE"
        android:textSize="9sp" />
</LinearLayout>